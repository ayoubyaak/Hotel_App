{% extends 'admin/base.html.twig' %}

{% block title %}Modifier client{% endblock %}

{% block body %}

    <div class="category-page">

        <div class="page-header">
            <h2>Modifier client</h2>
        </div>

        <div class="card category-card p-4">

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.fullName, 'Nom complet') }}
                {{ form_widget(form.fullName, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.fullName) }}
            </div>

            {# نفس الملاحظة: زِد أي حقول أخرى هنا #}

            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('admin_client_index') }}" class="btn btn-secondary">
                    ← Retour
                </a>

                <button class="btn btn-primary">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}

        </div>

    </div>

{% endblock %}
