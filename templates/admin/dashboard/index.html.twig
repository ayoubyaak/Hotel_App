{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}

    <div class="dashboard-wrapper">

        <h2 class="dashboard-title">
            Tableau de bord – Statistiques générales
        </h2>

        <div class="dashboard-stats">

            <div class="stat-box">
                <div class="stat-icon"><i class="fa fa-list"></i></div>
                <div class="stat-info">
                    <span>Catégories</span>
                    <strong>{{ stats.categories }}</strong>
                </div>
            </div>

            <div class="stat-box">
                <div class="stat-icon"><i class="fa fa-users"></i></div>
                <div class="stat-info">
                    <span>Clients</span>
                    <strong>{{ stats.clients }}</strong>
                </div>
            </div>

            <div class="stat-box">
                <div class="stat-icon"><i class="fa fa-bed"></i></div>
                <div class="stat-info">
                    <span>Chambres</span>
                    <strong>{{ stats.rooms }}</strong>
                </div>
            </div>

            <div class="stat-box">
                <div class="stat-icon"><i class="fa fa-calendar-check"></i></div>
                <div class="stat-info">
                    <span>Réservations</span>
                    <strong>{{ stats.reservations }}</strong>
                </div>
            </div>

        </div>

    </div>

{% endblock %}
