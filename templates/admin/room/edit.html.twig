{% extends 'admin/base.html.twig' %}
{% block title %}Modifier la chambre{% endblock %}

{% block body %}
    <div class="room-form-page">
        <div class="room-form-card">

            <h1>Modifier la chambre</h1>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <div class="room-form-grid">

                {{ form_row(form.number) }}
                {{ form_row(form.price) }}

                <div class="full">
                    {{ form_row(form.description) }}
                </div>

                <div class="full">
                    {{ form_row(form.available) }}
                </div>

                {{ form_row(form.category) }}
                {{ form_row(form.roomClass) }}

                <div class="full">
                    {{ form_row(form.imageFile) }}
                </div>

            </div>

            <button class="btn btn-success w-100 mt-3">
                Mettre à jour
            </button>

            {{ form_end(form) }}

            <a href="{{ path('admin_room_index') }}" class="back-link">
                ← Retour
            </a>

        </div>
    </div>
{% endblock %}
