{% extends 'admin/base.html.twig' %}

{% block title %}Chambres{% endblock %}

{% block page_title %}Chambres{% endblock %}

{% block body %}

    <div class="rooms-admin-page">

        <!-- HEADER -->
        <div class="page-header d-flex justify-content-between align-items-center mb-4">
            <h2>Chambres</h2>

            <a href="{{ path('admin_room_new') }}" class="btn btn-primary">
                <i class="fa fa-plus"></i> Ajouter
            </a>
        </div>

        <!-- ROOMS GRID -->
        <div class="rooms-grid">

            {% for room in rooms %}
                <div class="room-card">

                    <!-- IMAGE -->
                    <div class="room-image">
                        {% if room.image %}
                            <img src="/assets/images/{{ room.image }}"
                                 alt="Room {{ room.number }}">
                        {% else %}
                            <img src="/assets/images/default-room.jpg"
                                 alt="Room">
                        {% endif %}
                    </div>

                    <!-- CONTENT -->
                    <div class="room-body">

                        <h3>Room {{ room.number }}</h3>

                        <p class="room-meta">
                            {{ room.category.name }} • {{ room.roomClass.name }}
                        </p>

                        <div class="room-price">
                            {{ room.price }} TND / night
                        </div>

                        <!-- STATUS -->
                        {% if room.available %}
                            <span class="badge bg-success mb-2">Disponible</span>
                        {% else %}
                            <span class="badge bg-danger mb-2">Indisponible</span>
                        {% endif %}

                        <!-- ACTIONS -->
                        <div class="room-actions mt-3">
                            <a href="{{ path('admin_room_edit', {id: room.id}) }}"
                               class="btn btn-sm btn-secondary">
                                Edit
                            </a>

                            <form method="post"
                                  action="{{ path('admin_room_delete', {id: room.id}) }}"
                                  style="display:inline"
                                  onsubmit="return confirm('Supprimer cette chambre ?');">
                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('delete' ~ room.id) }}">
                                <button class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>

                </div>
            {% else %}
                <p class="text-center">Aucune chambre trouvée</p>
            {% endfor %}

        </div>

    </div>

{% endblock %}
