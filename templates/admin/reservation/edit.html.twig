{% extends 'admin/base.html.twig' %}

{% block title %}Réservation{% endblock %}

{% block body %}
    <div class="reservation-form-page">

        <div class="page-header">
            <h2>Modifier la réservation</h2>
            <a href="{{ path('admin_reservation_index') }}" class="btn btn-outline-secondary">
                ← Retour
            </a>
        </div>

        <div class="card reservation-form-card">
            <div class="card-body">

                {{ form_start(form) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.client) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.room) }}
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        {{ form_row(form.startDate) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.endDate) }}
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary">
                        Enregistrer
                    </button>
                    <a href="{{ path('admin_reservation_index') }}" class="btn btn-secondary">
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}

            </div>
        </div>

    </div>
{% endblock %}
