{% extends 'base.html.twig' %}

{% block title %}Login – Keto Hotel{% endblock %}

{% block body %}

    <style>
        /* ===== LOGIN PAGE ===== */

        body {
            min-height: 100vh;
            margin: 0;
            background: url('/assets/images/about.png') no-repeat center center / cover;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .login-overlay {
            min-height: 100vh;
            background: rgba(0, 0, 0, 0.55);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #ffffff;
            padding: 40px 35px;
            width: 100%;
            max-width: 420px;
            border-radius: 14px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.35);
        }

        .login-title {
            text-align: center;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 25px;
            color: #222;
        }

        .form-control {
            height: 46px;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            border-radius: 30px;
            font-weight: bold;
            background: linear-gradient(135deg, #d40000, #ff3b3b);
            border: none;
            color: #fff;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #a80000, #e60000);
        }

        .remember-me {
            font-size: 14px;
            color: #555;
        }

        .login-footer {
            text-align: center;
            margin-top: 15px;
            font-size: 14px;
            color: #666;
        }

        .login-footer a {
            color: #d40000;
            text-decoration: none;
            font-weight: 600;
        }

    </style>

    <div class="login-overlay">

        <div class="login-card">

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-success">
                    You are logged in as <strong>{{ app.user.userIdentifier }}</strong>,
                    <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <h1 class="login-title">Sign in to Keto Hotel</h1>

            <form method="post">

                <input
                    type="email"
                    name="email"
                    value="{{ last_username }}"
                    class="form-control"
                    placeholder="Email address"
                    autocomplete="email"
                    required
                    autofocus
                >

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    placeholder="Password"
                    autocomplete="current-password"
                    required
                >

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <div class="form-check mb-3 remember-me">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Remember me
                    </label>
                </div>

                <button class="btn btn-login" type="submit">
                    Sign In
                </button>

            </form>

            <div class="login-footer">
                © {{ "now"|date("Y") }} Keto Hotel
            </div>

        </div>

    </div>

{% endblock %}
