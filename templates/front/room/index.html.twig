{% extends 'front/base.html.twig' %}

{% block title %}Our Rooms{% endblock %}

{% block body %}

    <div class="rooms-page">
        <h1 class="page-title">Our Rooms</h1>

        <div class="rooms-list">

            {% for room in rooms %}
                <div class="room-card">

                    {% if room.image %}
                        <img src="/assets/images/{{ room.image }}"
                             alt="Room {{ room.number }}">
                    {% else %}
                        <img src="/assets/images/default-room.jpg"
                             alt="Room">
                    {% endif %}

                    <h3>Room {{ room.number }}</h3>
                    <p>{{ room.description }}</p>
                    <strong>{{ room.price }} TND / night</strong>

                    <br><br>

                    <a href="{{ path('front_room_show', {id: room.id}) }}">
                        View Details
                    </a>

                </div>
            {% endfor %}

        </div>
    </div>

{% endblock %}
