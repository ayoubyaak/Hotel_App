{% extends 'front/base.html.twig' %}

{% block title %}
    Room {{ room.number }}
{% endblock %}

{% block body %}

    <div style="
    max-width: 900px;
    margin: 40px auto;
    padding: 25px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    font-family: 'Segoe UI', Arial, sans-serif;
    text-align: center;
">

        <h1 style="margin-bottom: 25px;">
            Room {{ room.number }}
        </h1>

        {# IMAGE #}
        {% if room.image %}
            <img
                src="/assets/images/{{ room.image }}"
                alt="Room {{ room.number }}"
                style="
                width: 100%;
                max-width: 650px;
                border-radius: 12px;
                margin-bottom: 25px;
            "
            >
        {% else %}
            <img
                src="/assets/images/default-room.jpg"
                alt="Room"
                style="
                width: 100%;
                max-width: 650px;
                border-radius: 12px;
                margin-bottom: 25px;
            "
            >
        {% endif %}

        {# DESCRIPTION #}
        <p style="
        font-size: 16px;
        color: #555;
        line-height: 1.8;
        max-width: 700px;
        margin: 0 auto 15px;
    ">
            {{ room.description }}
        </p>

        {# PRICE #}
        <p style="
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
    ">
            {{ room.price }} TND / night
        </p>

        {# AVAILABILITY #}
        <p style="margin-bottom: 20px;">
            {% if room.available %}
                <span style="color: green; font-weight: bold;">Available</span>
            {% else %}
                <span style="color: red; font-weight: bold;">Not Available</span>
            {% endif %}
        </p>

        {# BUTTONS #}
        {% if room.available %}
            <a
                href="{{ path('front_reservation_book', { roomId: room.id }) }}"
                style="
                display: inline-block;
                padding: 12px 28px;
                background: #dc3545;
                color: #fff;
                text-decoration: none;
                border-radius: 6px;
                font-weight: bold;
                margin-bottom: 15px;
            "
            >
                Book Now
            </a>
        {% else %}
            <p style="color: red; font-weight: bold;">
                Not available
            </p>
        {% endif %}

        <br>

        {# BACK BUTTON #}
        <a
            href="{{ path('front_room_index') }}"
            style="
            display: inline-block;
            margin-top: 15px;
            color: #333;
            text-decoration: none;
            font-weight: bold;
        "
        >
            ← Back to rooms
        </a>

    </div>

{% endblock %}
