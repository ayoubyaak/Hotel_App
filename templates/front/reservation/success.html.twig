{% extends 'front/base.html.twig' %}

{% block title %}Reservation Success{% endblock %}

{% block body %}
    <section class="reservation-success">
        <div class="container">

            <h2>✅ Reservation Confirmed</h2>

            <p>
                <strong>Room:</strong> {{ reservation.room.number }}
            </p>

            <p>
                <strong>From:</strong> {{ reservation.startDate|date('Y-m-d') }} <br>
                <strong>To:</strong> {{ reservation.endDate|date('Y-m-d') }}
            </p>

            <p>
                <strong>Total Price:</strong> {{ reservation.totalPrice }} TND
            </p>

            <hr>

            <a href="{{ path('front_room_index') }}" class="btn btn-primary">
                Back to Rooms
            </a>

        </div>
    </section>
{% endblock %}
