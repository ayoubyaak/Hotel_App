{% extends 'front/base.html.twig' %}

{% block title %}Book Room {{ room.number }}{% endblock %}

{% block body %}
    <section class="booking-page">
        <div class="container">

            <h1 class="page-title">Book Room {{ room.number }}</h1>

            <div class="booking-wrapper">

                <!-- Room Info -->
                <div class="booking-room">
                    <img src="/assets/images/{{ room.image }}" alt="Room {{ room.number }}">

                    <h3>Room {{ room.number }}</h3>
                    <p>{{ room.description }}</p>
                    <strong>{{ room.price }} TND / night</strong>
                </div>

                <!-- Reservation Form -->
                <div class="booking-form">
                    {{ form_start(form) }}

                    <div class="form-group">
                        {{ form_row(form.startDate) }}
                    </div>

                    <div class="form-group">
                        {{ form_row(form.endDate) }}
                    </div>

                    <div class="form-group">
                        {{ form_row(form.guestFullName) }}
                    </div>

                    <div class="form-group">
                        {{ form_row(form.guestEmail) }}
                    </div>

                    <div class="form-group">
                        {{ form_row(form.guestPhone) }}
                    </div>

                    <div class="form-group">
                        {{ form_row(form.guestCin) }}
                    </div>

                    <div class="payment-section">
                        <h4 class="section-title">Payment Method</h4>

                        <div class="payment-options">
                            {{ form_row(form.paymentMethod) }}
                        </div>
                    </div>




                    <button class="btn-book">Confirm Reservation</button>

                    {{ form_end(form) }}
                </div>

            </div>

        </div>
    </section>
{% endblock %}
