{% extends 'front/base.html.twig' %}

{% block title %}Contact – Keto Hotel{% endblock %}

{% block body %}

    <style>
        /* ===== CONTACT BACKGROUND ===== */
        .contact-page {
            position: relative;
            padding: 120px 0;
            background: url('/assets/images/about.png') center/cover no-repeat;
        }

        /* overlay */
        .contact-page::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
        }

        /* content over background */
        .contact-content {
            position: relative;
            z-index: 2;
            max-width: 1100px;
            margin: auto;
            padding: 0 20px;
        }

        /* title */
        .titlepage {
            text-align: center;
            margin-bottom: 60px;
        }

        .titlepage h2 {
            font-size: 44px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 2px;
        }

        /* FORM CARD */
        .contact-form {
            background: rgba(255,255,255,0.95);
            max-width: 520px;
            margin: auto;
            padding: 45px;
            border-radius: 22px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.35);
        }

        /* inputs */
        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 15px 20px;
            margin-bottom: 18px;
            border-radius: 14px;
            border: 1px solid #ddd;
            font-size: 15px;
            outline: none;
            transition: all 0.3s ease;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #e60000;
            box-shadow: 0 0 0 2px rgba(230,0,0,0.15);
        }

        .contact-form textarea {
            height: 140px;
            resize: none;
        }

        /* button */
        .send-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #e60000, #ff3b3b);
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .send-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(230,0,0,0.45);
        }
    </style>

    <section class="contact-page">
        <div class="contact-content">

            <div class="titlepage">
                <h2>CONTACT US</h2>
            </div>

            <div class="contact-form">
                <form method="post">
                    <input type="text" placeholder="Your Name">
                    <input type="email" placeholder="Email">
                    <input type="text" placeholder="Phone">
                    <textarea placeholder="Message"></textarea>
                    <button class="send-btn">Send Message</button>
                </form>
            </div>

        </div>
    </section>

{% endblock %}
